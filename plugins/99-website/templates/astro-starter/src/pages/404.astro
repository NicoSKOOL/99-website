---
import Base from "../layouts/Base.astro";
import site from "../data/site.json";
const page = { url: "/404/", title: `Page not found | ${site.business.name}`, type: "legal", page_name: "Not found", parent: "/" };
const content = { description: `That page does not exist. Go back to the ${site.business.name} home page or see our services.` };
---
<Base page={page} content={content}>
<div class="mx-auto max-w-3xl px-4 py-16">
  <h1 class="text-4xl font-semibold">Page not found</h1>
  <p class="mt-4">That page does not exist. Try the <a href="/" class="underline">home page</a> or our <a href="/services/" class="underline">services</a>.</p>
</div>
</Base>
