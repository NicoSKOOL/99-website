---
import InlineCta from "./InlineCta.astro";
const { sections = [], ctaAfterEach = false } = Astro.props;
---
{sections.map((s) => (
  <section class="mt-12 first:mt-0">
    <h2>{s.h2}</h2>
    {(s.paragraphs || []).map((p) => <p class="mt-3">{p}</p>)}
    {s.bullets?.length > 0 && (
      <ul class="mt-4 grid gap-2 sm:grid-cols-2">
        {s.bullets.map((b) => <li class="border-l-2 border-brand pl-3">{b}</li>)}
      </ul>
    )}
    {ctaAfterEach && <InlineCta />}
  </section>
))}
