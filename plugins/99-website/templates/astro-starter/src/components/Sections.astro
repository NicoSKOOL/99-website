---
import CtaBand from "./CtaBand.astro";
const { sections = [], ctaAfterEach = false } = Astro.props;
---
{sections.map((s) => (
  <>
    <section>
      <h2>{s.h2}</h2>
      {(s.paragraphs || []).map((p) => <p class="mt-3">{p}</p>)}
      {s.bullets?.length > 0 && <ul class="mt-3 list-disc space-y-1 pl-6">{s.bullets.map((b) => <li>{b}</li>)}</ul>}
    </section>
    {ctaAfterEach && <CtaBand />}
  </>
))}
