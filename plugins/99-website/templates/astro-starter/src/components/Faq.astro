---
const { faqs = [] } = Astro.props;
---
{faqs.length > 0 && (
  <section>
    <h2>Questions</h2>
    {faqs.map((f) => (
      <details class="border-b border-ink/10 py-3">
        <summary class="cursor-pointer font-medium">{f.q}</summary>
        <p class="mt-2">{f.a}</p>
      </details>
    ))}
  </section>
)}
