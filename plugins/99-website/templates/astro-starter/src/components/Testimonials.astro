---
// Real (sourced) customer words only: site-data drops any quote without a source.
// layout "feature": one large quote plus up to two smaller ones (home). "single": one pull quote (service pages).
import site from "../data/site.json";
const { service = "", layout = "feature", heading = "What customers say" } = Astro.props;
const all = site.testimonials || [];
const match = all.filter((t) => t.service === service);
const pool = layout === "single" ? (match.length ? match : []) : [...all].sort((a, b) => (b.featured ? 1 : 0) - (a.featured ? 1 : 0));
const [lead, ...more] = pool;
const cite = (t) => [t.name, t.place].filter(Boolean).join(", ");
const svc = (t) => site.nav.services.find((s) => s.url.includes(`/${t.service}/`));
---
{lead && layout === "single" && (
  <figure class="mx-auto max-w-4xl px-4 py-14 md:py-20">
    <blockquote class="text-2xl leading-snug font-medium text-ink md:text-3xl"><p class="max-w-none">&ldquo;{lead.quote}&rdquo;</p></blockquote>
    <figcaption class="mt-5 text-muted"><span class="font-semibold text-ink">{cite(lead)}</span>{lead.job && <>. {lead.job}</>}</figcaption>
  </figure>
)}
{lead && layout === "feature" && (
  <section class="mx-auto max-w-6xl px-4 py-14 md:py-20">
    <h2 class="mt-0">{heading}</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-5">
      <figure class="flex flex-col justify-between rounded-md bg-brand p-8 text-paper md:col-span-3 md:p-10">
        <blockquote class="text-2xl leading-snug font-medium md:text-[1.7rem]"><p class="max-w-none">&ldquo;{lead.quote}&rdquo;</p></blockquote>
        <figcaption class="mt-8"><span class="font-semibold">{cite(lead)}</span>{svc(lead) && <><br /><a href={svc(lead).url} class="text-sm underline underline-offset-4">{lead.job || svc(lead).name}</a></>}</figcaption>
      </figure>
      <div class="grid gap-6 md:col-span-2">
        {more.slice(0, 2).map((t) => (
          <figure class="border-l-2 border-brand py-1 pl-5">
            <blockquote class="text-lg leading-relaxed"><p>&ldquo;{t.quote}&rdquo;</p></blockquote>
            <figcaption class="mt-3 text-sm text-muted"><span class="font-semibold text-ink">{cite(t)}</span>{svc(t) && <>. <a href={svc(t).url} class="underline underline-offset-4 hover:text-brand">{t.job || svc(t).name}</a></>}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
