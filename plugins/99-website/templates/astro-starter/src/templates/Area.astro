---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sections from "../components/Sections.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import site from "../data/site.json";
const { page, content } = Astro.props;
const b = site.business;
const tel = `tel:${b.phone.replace(/[^+\d]/g, "")}`;
import CallBar from "../components/CallBar.astro";
---
<Base page={page} content={content}>
<div class="mx-auto max-w-6xl px-4 py-6 pb-20 md:pb-10">
  <Breadcrumbs page={page} />
  <Hero content={content} />
  <section>
    <h2>Services in {page.page_name}</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">{site.nav.services.map((s) => <li><a href={s.url} class="underline">{s.name}</a></li>)}</ul>
  </section>
  <Sections sections={content.sections} />
  <CtaBand />
  <Faq faqs={content.faqs} />
</div>
<CallBar />
</Base>
