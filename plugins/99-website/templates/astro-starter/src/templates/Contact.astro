---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sections from "../components/Sections.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import site from "../data/site.json";
const { page, content } = Astro.props;
const b = site.business;
const tel = `tel:${b.phone.replace(/[^+\d]/g, "")}`;
---
<Base page={page} content={content}>
<div class="mx-auto max-w-3xl px-4 py-6">
  <Breadcrumbs page={page} />
  <h1 class="mt-6 text-4xl font-semibold">{content.h1}</h1>
  <p class="mt-4 text-lg">{content.intro}</p>
  <p class="mt-4"><a href={tel} class="font-semibold underline">{b.phone}</a>{b.email && <> · <a href={`mailto:${b.email}`} class="underline">{b.email}</a></>}</p>
  <form method="post" action="/api/contact" class="mt-8 grid gap-4">
    <label class="grid gap-1">Name<input name="name" required autocomplete="name" class="rounded-md border border-ink/30 px-3 py-2" /></label>
    <label class="grid gap-1">Email<input name="email" type="email" required autocomplete="email" class="rounded-md border border-ink/30 px-3 py-2" /></label>
    <label class="grid gap-1">Phone<input name="phone" type="tel" autocomplete="tel" class="rounded-md border border-ink/30 px-3 py-2" /></label>
    <label class="grid gap-1">What do you need?<textarea name="message" rows="5" required class="rounded-md border border-ink/30 px-3 py-2"></textarea></label>
    <button type="submit" class="rounded-md bg-brand px-5 py-3 font-medium text-paper hover:bg-ink">Get a free estimate</button>
  </form>
  <Sections sections={content.sections} />
</div>
</Base>
