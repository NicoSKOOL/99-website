---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Img from "../components/Img.astro";
import ProofStrip from "../components/ProofStrip.astro";
import Testimonials from "../components/Testimonials.astro";
import EstimateForm from "../components/EstimateForm.astro";
import CallBar from "../components/CallBar.astro";
import Faq from "../components/Faq.astro";
import site from "../data/site.json";
import { contentFor, hasContent } from "../lib/content.js";
const { page, content } = Astro.props;
const b = site.business;
const services = site.pages.filter((p) => p.type === "service");
// The first three rows of the site map are the money-makers: feature them, list the rest.
const [lead, ...pair] = services.slice(0, 3);
const rest = services.slice(3);
const c = (p) => (hasContent(p) ? contentFor(p) : {});
const band = content.sections?.[0];
---
<Base page={page} content={content}>
<div class="mx-auto max-w-6xl px-4">
  <Hero content={content} />
</div>
<ProofStrip />

<section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
  <h2 class="mt-0">What we build</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-5">
    {lead && (
      <a href={lead.url} class="group block md:col-span-3">
        {c(lead).hero_image && <Img name={c(lead).hero_image} alt={c(lead).hero_alt || ""} sizes="(min-width: 768px) 60vw, 100vw" class="aspect-[4/3] h-auto w-full rounded-md object-cover" />}
        <h3 class="mt-4 text-2xl font-semibold text-brand group-hover:underline">{lead.page_name}</h3>
        <p class="mt-1 text-muted">{c(lead).intro}</p>
      </a>
    )}
    <div class="grid gap-6 md:col-span-2">
      {pair.map((s) => (
        <a href={s.url} class="group block">
          {c(s).hero_image && <Img name={c(s).hero_image} alt={c(s).hero_alt || ""} sizes="(min-width: 768px) 40vw, 100vw" class="aspect-[16/9] h-auto w-full rounded-md object-cover" />}
          <h3 class="mt-3 text-xl font-semibold text-brand group-hover:underline">{s.page_name}</h3>
          <p class="mt-1 text-muted">{c(s).intro}</p>
        </a>
      ))}
    </div>
  </div>
  {rest.length > 0 && (
    <ul class="mt-10 grid gap-x-10 border-t border-stone/60 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((s) => (
        <li class="border-b border-stone/60">
          <a href={s.url} class="flex items-center justify-between gap-4 px-1 py-4 font-medium text-ink hover:text-brand">
            <span>{s.page_name}</span><span aria-hidden="true" class="text-brand">&rarr;</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>

{band && (
  <section class="relative isolate overflow-hidden bg-brand-deep text-paper">
    <Img name="home-band" alt="" sizes="100vw" class="absolute inset-0 -z-10 h-full w-full object-cover opacity-55" />
    <div class="mx-auto max-w-6xl px-4 py-20 md:py-28">
      <h2 class="mt-0 max-w-xl text-3xl md:text-4xl">{band.h2}</h2>
      {(band.paragraphs || []).map((p) => <p class="mt-4 max-w-xl text-lg text-paper">{p}</p>)}
    </div>
  </section>
)}

<Testimonials />

<section class="mx-auto max-w-6xl px-4 pb-4">
  {site.nav.areas.length > 0 && (
    <>
      <h2 class="mt-0">Where we work</h2>
      <p class="mt-3 text-muted">{b.home_city} and towns within about 30 miles.</p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {site.nav.areas.map((a) => <li><a href={a.url} class="flex items-center justify-between rounded-md border border-stone px-4 py-3 font-medium hover:border-brand hover:text-brand"><span>{a.name}</span><span aria-hidden="true" class="text-brand">&rarr;</span></a></li>)}
      </ul>
    </>
  )}
</section>
<Faq faqs={content.faqs} layout="split" />
<EstimateForm />
<CallBar />
</Base>
