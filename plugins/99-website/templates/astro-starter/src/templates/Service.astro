---
import Base from "../layouts/Base.astro";
import Img from "../components/Img.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sections from "../components/Sections.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import site from "../data/site.json";
const { page, content } = Astro.props;
const b = site.business;
const tel = `tel:${b.phone.replace(/[^+\d]/g, "")}`;
import CallBar from "../components/CallBar.astro";
---
<Base page={page} content={content}>
<div class="mx-auto max-w-6xl px-4 py-6 pb-20 md:pb-10">
  <Breadcrumbs page={page} />
  <Hero content={content} />
  <Sections sections={content.sections} ctaAfterEach />
  {content.steps?.length > 0 && (
    <section>
      <h2>How it works</h2>
      <ol class="mt-4 space-y-4">
        {content.steps.map((s, i) => <li class="flex gap-4"><span class="text-2xl font-semibold text-brand">{i + 1}</span><div><h3 class="font-semibold">{s.name}</h3><p>{s.text}</p></div></li>)}
      </ol>
    </section>
  )}
  <Faq faqs={content.faqs} />
  <CtaBand />
</div>
<CallBar />
</Base>
