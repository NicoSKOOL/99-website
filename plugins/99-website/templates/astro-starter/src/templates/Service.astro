---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import Sections from "../components/Sections.astro";
import AtAGlance from "../components/AtAGlance.astro";
import Steps from "../components/Steps.astro";
import CtaBand from "../components/CtaBand.astro";
import Faq from "../components/Faq.astro";
import CallBar from "../components/CallBar.astro";
const { page, content } = Astro.props;
---
<Base page={page} content={content}>
<div class="mx-auto max-w-6xl px-4 pt-6">
  <Breadcrumbs page={page} />
  <Hero content={content} />
</div>
<div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-3">
  <div class="md:col-span-2"><Sections sections={content.sections} ctaAfterEach /></div>
  <div><AtAGlance content={content} /></div>
</div>
<Steps steps={content.steps} />
<div class="mx-auto max-w-6xl px-4 pb-20 pt-12 md:pb-10">
  <Faq faqs={content.faqs} />
  <CtaBand />
</div>
<CallBar />
</Base>
